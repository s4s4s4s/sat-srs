{
  "name": "sat-srs",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "npm run test:session && npm run test:metrics && npm run test:journal && npm run test:math && npm run test:sound && npm run test:coach && npm run test:data && npm run test:settings && npm run test:sync-safety && npm run test:reading && npm run test:wordlist && npm run test:synonyms && npm run test:practice && npm run test:practice-screen && npm run test:styles",
    "test:session": "esbuild test/session-sim.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/sat-srs/session-sim.mjs && node node_modules/.cache/sat-srs/session-sim.mjs",
    "test:metrics": "esbuild test/metrics.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/sat-srs/metrics.mjs && node node_modules/.cache/sat-srs/metrics.mjs",
    "test:journal": "esbuild test/journal.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/sat-srs/journal.mjs && node node_modules/.cache/sat-srs/journal.mjs",
    "test:data": "esbuild test/data.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/sat-srs/data.mjs && node node_modules/.cache/sat-srs/data.mjs",
    "test:math": "esbuild test/math-pilot.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/sat-srs/math-pilot.mjs && node node_modules/.cache/sat-srs/math-pilot.mjs",
    "icons": "node scripts/make-icons.mjs",
    "test:sound": "esbuild test/sound.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/sat-srs/sound.mjs && node node_modules/.cache/sat-srs/sound.mjs",
    "test:coach": "esbuild test/coach.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/sat-srs/coach.mjs && node node_modules/.cache/sat-srs/coach.mjs",
    "test:settings": "esbuild test/settings.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/sat-srs/settings.mjs && node node_modules/.cache/sat-srs/settings.mjs",
    "test:sync-safety": "esbuild test/sync-safety.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/sat-srs/sync-safety.mjs && node node_modules/.cache/sat-srs/sync-safety.mjs",
    "test:reading": "esbuild test/reading.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/sat-srs/reading.mjs && node node_modules/.cache/sat-srs/reading.mjs",
    "test:wordlist": "esbuild test/wordlist.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/sat-srs/wordlist.mjs && node node_modules/.cache/sat-srs/wordlist.mjs",
    "test:synonyms": "esbuild test/synonyms.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/sat-srs/synonyms.mjs && node node_modules/.cache/sat-srs/synonyms.mjs",
    "test:practice": "esbuild test/practice.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/sat-srs/practice.mjs --external:fake-indexeddb && node node_modules/.cache/sat-srs/practice.mjs",
    "test:practice-screen": "esbuild test/practice-screen.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/sat-srs/practice-screen.mjs && node node_modules/.cache/sat-srs/practice-screen.mjs",
    "test:styles": "esbuild test/styles.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/sat-srs/styles.mjs && node node_modules/.cache/sat-srs/styles.mjs",
    "sounds": "node scripts/sound-wav.mjs"
  },
  "dependencies": {
    "@fontsource/nunito": "^5.2.5",
    "idb": "^8.0.2",
    "js-yaml": "^4.1.0",
    "katex": "^0.18.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "ts-fsrs": "^5.4.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/katex": "^0.16.8",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "fake-indexeddb": "^6.2.5",
    "puppeteer-core": "^25.3.0",
    "sharp": "^0.34.2",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.0.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "sharp@0.34.5": true
  }
}
